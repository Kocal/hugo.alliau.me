<twig:Navbar:Nav label="Main" class="{{ css({
    order: {base: 9999, sm: 0},
    w: {base: 'full', sm: 'auto'},
    flex: {sm: '1'},
}) }}">
    <ul class="{{ css({
        display: 'flex',
        columnGap: {base: '3', sm: '4'},
    }) }}">
        {% for child in item.children %}
            {% set is_current = matcher.isCurrent(child) or matcher.isAncestor(child) %}
            <twig:Navbar:NavItem class="{{ css({
                display: 'block',
                shadow: is_current ? '[inset 0 -0.25rem 0 0 token(colors.primary.500)]' : '[none]',
            }) }}">
                <a
                    href="{{ child.uri }}"
                    class="{{ css({
                        display: 'block',
                        py: {base: '2', sm: '1'},
                        px: {sm: '1'},
                    }) }}"
                    {% if is_current %}aria-current="page"{% endif %}
                >
                    {{ (child.label ?? child.name)|trans }}
                </a>
            </twig:Navbar:NavItem>
        {% endfor %}
    </ul>
</twig:Navbar:Nav>
