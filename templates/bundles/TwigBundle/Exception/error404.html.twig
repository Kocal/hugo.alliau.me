{% extends 'base.html.twig' %}

{% block title %}{{ 'error.not_found.title'|trans }} | Hugo Alliaume{% endblock %}

{% block seo %}
    <meta name="robots" content="noindex">
{% endblock %}

{% block main %}
<main class="{{ css({
    w: 'full',
    mx: 'auto',
    px: '2',
    py: {base: '12', sm: '24'},
    maxW: 'breakpoint-md',
    display: 'flex',
    flexDirection: 'column',
    alignItems: 'center',
    gap: '4',
    textAlign: 'center',
}) }}">
    <p class="{{ css({
        fontSize: {base: '7xl', sm: '9xl'},
        lineHeight: {base: '7xl', sm: '9xl'},
        fontWeight: 'extrabold',
        letterSpacing: 'tight',
        color: 'accent.emphasis',
    }) }}">404</p>

    <h1 class="{{ css({
        fontSize: {base: '3xl', sm: '5xl'},
        lineHeight: {base: '3xl', sm: '5xl'},
        fontWeight: 'extrabold',
        letterSpacing: 'tight',
    }) }}">
        {{ 'error.not_found.title'|trans }}
    </h1>

    <p class="{{ css({
        fontSize: 'lg',
        lineHeight: 'lg',
    }) }}">{{ 'error.not_found.description'|trans }}</p>

    <a href="{{ path(constant('App\\Shared\\Domain\\Data\\Route::HOME').value) }}"
       class="{{ css({
           mt: '4',
           rounded: 'lg',
           borderWidth: 1,
           borderColor: 'border',
           px: '4',
           py: '2',
           color: 'fg.secondary',
           transition: 'colors',
           bgColor: {_hover: 'bg.hover'},
       }) }}">
        {{ 'error.not_found.back_home'|trans }}
    </a>
</main>
{% endblock %}
