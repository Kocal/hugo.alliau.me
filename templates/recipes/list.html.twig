{% extends 'base.html.twig' %}

{% block title %}{{ 'recipes.title'|trans }} | Hugo Alliaume{% endblock %}

{% block seo %}
    <meta name="description" content="{{ 'recipes.meta_description'|trans }}">
{% endblock %}

{% block main %}
<main class="container mx-auto p-2 sm:py-4 max-w-screen-lg">
    <h1 class="text-3xl sm:text-5xl font-extrabold mb-6 sm:mb-8 tracking-tight text-center">
        {{ 'recipes.title'|trans }}
    </h1>

    <div class="flex flex-col gap-4">
        {% for recipe in recipes %}
            <twig:Card as="article" class="p-4 sm:p-6">
                <header>
                    <h2 class="text-2xl sm:text-3xl font-bold mb-3 tracking-tight hover:text-primary-700 dark:hover:text-slate-400 transition-colors">
                        <a data-testid="recipe-link"
                           href="{{ path(constant('App\\Recipes\\Domain\\Data\\Route::VIEW').value, {slug: recipe.slug, _locale: recipe.locale.value}) }}">
                            {{ recipe.name }}
                        </a>
                    </h2>
                </header>

                <footer class="flex items-center gap-x-2">
                    <span class="text-lg" title="{{ recipe.locale.toTranslatable|trans }}" aria-label="{{ recipe.locale.toTranslatable|trans }}">{{ recipe.locale.flag }}</span>
                    <twig:Badge>{{ recipe.type.toTranslatable|trans }}</twig:Badge>
                </footer>
            </twig:Card>
        {% else %}
            <p>{{ 'recipes.empty'|trans }}</p>
        {% endfor %}
    </div>
</main>
{% endblock %}
