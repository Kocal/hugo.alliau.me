{% extends 'base.html.twig' %}

{% block title %}{{ 'recipes.title'|trans }} | Hugo Alliaume{% endblock %}

{% block seo %}
    <meta name="description" content="{{ 'recipes.meta_description'|trans }}">
{% endblock %}

{% block main %}
<main class="{{ css({
    w: 'full',
    mx: 'auto',
    p: '2',
    py: {sm: '4'},
    maxW: 'breakpoint-lg',
}) }}">
    <h1 class="{{ css({
        fontSize: {base: '3xl', sm: '5xl'},
        lineHeight: {base: '3xl', sm: '5xl'},
        fontWeight: 'extrabold',
        mb: {base: '6', sm: '8'},
        letterSpacing: 'tight',
        textAlign: 'center',
    }) }}">
        {{ 'recipes.title'|trans }}
    </h1>

    <div class="{{ css({
        display: 'flex',
        flexDirection: 'column',
        gap: '4',
    }) }}">
        {% for recipe in recipes %}
            <twig:Card as="article" class="{{ css({
                p: {base: '4', sm: '6'},
            }) }}">
                <header>
                    <h2 class="{{ css({
                        fontSize: {base: '2xl', sm: '3xl'},
                        lineHeight: {base: '2xl', sm: '3xl'},
                        fontWeight: 'bold',
                        mb: '3',
                        letterSpacing: 'tight',
                        color: {_hover: 'fg.hover'},
                        transition: 'colors',
                    }) }}">
                        <a data-testid="recipe-link"
                           href="{{ path(constant('App\\Recipes\\Domain\\Data\\Route::VIEW').value, {slug: recipe.slug, _locale: recipe.locale.value}) }}">
                            {{ recipe.name }}
                        </a>
                    </h2>
                </header>

                {% if recipe.description %}
                    <p data-testid="recipe-description" class="{{ css({
                        mb: '4',
                    }) }}">{{ recipe.description }}</p>
                {% endif %}

                <footer class="{{ css({
                    display: 'flex',
                    alignItems: 'center',
                    columnGap: '2',
                }) }}">
                    <span class="{{ css({
                        fontSize: 'lg',
                        lineHeight: 'lg',
                    }) }}" title="{{ recipe.locale.toTranslatable|trans }}" aria-label="{{ recipe.locale.toTranslatable|trans }}">{{ recipe.locale.flag }}</span>
                    <twig:Badge>{{ recipe.type.toTranslatable|trans }}</twig:Badge>
                </footer>
            </twig:Card>
        {% else %}
            <p>{{ 'recipes.empty'|trans }}</p>
        {% endfor %}
    </div>
</main>
{% endblock %}
