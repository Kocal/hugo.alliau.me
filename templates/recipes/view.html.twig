{% extends 'base.html.twig' %}

{% block title %}{{ recipe.name }} | Hugo Alliaume{% endblock %}

{% block seo %}
    <meta name="description" content="{{ recipe.description ?: 'recipes.meta_description_detail'|trans({name: recipe.name, type: recipe.type.toTranslatable|trans, servings: recipe.servings}) }}">
{% endblock %}

{% set link_class = css({
    color: {base: 'link', _hover: 'link.hover'},
    textDecorationLine: 'underline',
    textUnderlineOffset: '2px',
    transition: 'colors',
}) %}

{% set counter_button_class = css({
    px: '3',
    fontSize: 'lg',
    lineHeight: 'none',
    color: 'fg.secondary',
    transition: 'colors',
    bgColor: {_hover: 'bg.hover'},
}) %}

{% block main %}
<main class="{{ css({
    w: 'full',
    mx: 'auto',
    p: '2',
    py: {sm: '4'},
    maxW: 'breakpoint-lg',
}) }}">
    {# Substituting empty min/max leaves only the separator, kept in sync with quantity.range #}
    <article data-controller="recipe-servings recipe-progress"
             data-recipe-servings-base-value="{{ recipe.servings }}"
             data-recipe-servings-range-separator-value="{{ 'quantity.range'|trans({min: '', max: ''}) }}"
             data-recipe-progress-key-value="{{ recipe.slug }}">
        <header class="{{ css({
            mb: '6',
        }) }}">
            <h1 class="{{ css({
                fontSize: {base: '3xl', sm: '5xl'},
                lineHeight: {base: '3xl', sm: '5xl'},
                fontWeight: 'extrabold',
                letterSpacing: 'tight',
            }) }}">{{ recipe.name }}</h1>

            <div class="{{ css({
                mt: '3',
            }) }}">
                <twig:Badge>{{ recipe.type.toTranslatable|trans }}</twig:Badge>
            </div>

            {% if recipe.description %}
                <p data-testid="recipe-description" class="{{ css({
                    mt: '3',
                }) }}">{{ recipe.description }}</p>
            {% endif %}

            {% if recipe.sourceLabel or recipe.sourceUrl %}
                <p class="{{ css({
                    mt: '3',
                    fontSize: 'sm',
                    lineHeight: 'sm',
                    color: 'fg.muted',
                }) }}">
                    {{ 'recipes.source_prefix'|trans }}
                    {%- if recipe.sourceLabel and recipe.sourceUrl %}
                        <a href="{{ recipe.sourceUrl }}" rel="noreferrer noopener" class="{{ link_class }}">{{ recipe.sourceLabel }}</a>
                    {%- elseif recipe.sourceLabel %}
                        {{ recipe.sourceLabel }}
                    {%- else %}
                        <a href="{{ recipe.sourceUrl }}" rel="noreferrer noopener" class="{{ link_class }}">{{ recipe.sourceUrl }}</a>
                    {%- endif %}
                </p>
            {% endif %}
        </header>

        <twig:Card class="{{ css({
            mb: '6',
            display: 'flex',
            flexWrap: 'wrap',
            alignItems: 'center',
            justifyContent: 'space-between',
            columnGap: '6',
            rowGap: '3',
            p: {base: '3', sm: '4'},
        }) }}">
            <div class="{{ css({
                display: 'flex',
                alignItems: 'center',
                gap: '3',
            }) }}">
                <label for="recipe-servings" class="{{ css({
                    fontSize: 'sm',
                    lineHeight: 'sm',
                    fontWeight: 'medium',
                }) }}">{{ 'recipes.servings_label'|trans }}</label>

                <div class="{{ css({
                    display: 'inline-flex',
                    alignItems: 'stretch',
                    overflow: 'hidden',
                    rounded: 'lg',
                    borderWidth: 1,
                    borderColor: 'border',
                }) }}">
                    <button type="button"
                            data-action="recipe-servings#decrease"
                            aria-label="{{ 'recipes.decrease'|trans }}"
                            class="{{ counter_button_class }}">&minus;</button>
                    <input id="recipe-servings" type="number" min="1" step="1"
                           value="{{ recipe.servings }}"
                           data-recipe-servings-target="input"
                           data-action="input->recipe-servings#update"
                           class="{{ css({
                               w: '12',
                               borderInlineWidth: 1,
                               borderColor: 'border',
                               py: '1.5',
                               textAlign: 'center',
                               fontWeight: 'semibold',
                               appearance: 'textfield',
                               '&::-webkit-inner-spin-button': {
                                   appearance: 'none',
                               },
                               '&::-webkit-outer-spin-button': {
                                   appearance: 'none',
                               },
                           }) }}">
                    <button type="button"
                            data-action="recipe-servings#increase"
                            aria-label="{{ 'recipes.increase'|trans }}"
                            class="{{ counter_button_class }}">+</button>
                </div>
            </div>

            <button type="button"
                    data-action="recipe-progress#reset"
                    class="{{ css({
                        rounded: 'lg',
                        borderWidth: 1,
                        borderColor: 'border',
                        px: '3',
                        py: '1.5',
                        fontSize: 'sm',
                        lineHeight: 'sm',
                        color: 'fg.secondary',
                        transition: 'colors',
                        bgColor: {_hover: 'bg.hover'},
                    }) }}">
                {{ 'recipes.reset'|trans }}
            </button>
        </twig:Card>

        <twig:Card class="{{ css({
            p: {base: '3', sm: '5'},
        }) }}">
            <twig:Recipe:Grid :recipe="recipe" />
        </twig:Card>
    </article>
</main>
{% endblock %}
