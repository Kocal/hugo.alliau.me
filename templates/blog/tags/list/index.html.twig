{% extends 'blog/base.html.twig' %}

{% block title %}{{ 'blog.tags.title'|trans }} | Hugo Alliaume{% endblock %}

{% block main %}
    <main class="container mx-auto p-2 sm:py-4 max-w-screen-lg">
        <h1 class="text-3xl sm:text-5xl font-extrabold mb-6 sm:mb-8 tracking-tight text-center">
            {{ 'blog.tags.title'|trans }}
        </h1>

        <twig:Card class="p-4 sm:p-6">
            <twig:Blog:CloudOfTags :tags="tags" />
        </twig:Card>
    </main>
{% endblock %}
