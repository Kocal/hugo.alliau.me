{% extends 'blog/base.html.twig' %}

{% block title %}{{ 'blog.tags.title'|trans }} | Hugo Alliaume{% endblock %}

{% block main %}
    <main class="{{ css({
        w: 'full',
        mx: 'auto',
        p: '2',
        py: {sm: '4'},
        maxW: 'breakpoint-lg',
    }) }}">
        <h1 class="{{ css({
            fontSize: {base: '3xl', sm: '5xl'},
            lineHeight: {base: '3xl', sm: '5xl'},
            fontWeight: 'extrabold',
            mb: {base: '6', sm: '8'},
            letterSpacing: 'tight',
            textAlign: 'center',
        }) }}">
            {{ 'blog.tags.title'|trans }}
        </h1>

        <twig:Card class="{{ css({
            p: {base: '4', sm: '6'},
        }) }}">
            <twig:Blog:CloudOfTags :tags="tags" />
        </twig:Card>
    </main>
{% endblock %}
