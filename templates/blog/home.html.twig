{% extends 'base.html.twig' %}

{% block title %}Blog | Hugo Alliaume{% endblock %}

{% block seo %}
    <meta name="description" content="{{ 'blog.meta_description'|trans }}">
{% endblock %}

{% block main %}
<main class="container mx-auto p-2 sm:py-4 max-w-screen-lg">
    <h1 class="text-3xl sm:text-5xl font-extrabold mb-6 sm:mb-8 tracking-tight text-center">
        Blog
    </h1>

    <div class="flex flex-col gap-4">
        {% for post in posts %}
            <twig:Blog:PostCard :post="post" />
        {% endfor %}
    </div>
</main>
{% endblock %}
