{% extends 'base.html.twig' %}

{% block title %}Blog | Hugo Alliaume{% endblock %}

{% block seo %}
    <meta name="description" content="{{ 'blog.meta_description'|trans }}">
{% endblock %}

{% block main %}
<main class="{{ css({
    w: 'full',
    mx: 'auto',
    p: '2',
    py: {sm: '4'},
    maxW: 'breakpoint-lg',
}) }}">
    <h1 class="{{ css({
        fontSize: {base: '3xl', sm: '5xl'},
        lineHeight: {base: '3xl', sm: '5xl'},
        fontWeight: 'extrabold',
        mb: {base: '6', sm: '8'},
        letterSpacing: 'tight',
        textAlign: 'center',
    }) }}">
        Blog
    </h1>

    <div class="{{ css({
        display: 'flex',
        flexDirection: 'column',
        gap: '4',
    }) }}">
        {% for post in posts %}
            <twig:Blog:PostCard :post="post" />
        {% endfor %}
    </div>
</main>
{% endblock %}
