{% import _self as m %}

{% macro ingredientData(component, node) %}
    {%- if node.min is not null %} data-qty-min="{{ node.min }}"{% endif -%}
    {%- if node.max is not null %} data-qty-max="{{ node.max }}"{% endif -%}
    {%- if node.unit %} data-unit-one="{{ component.unitFor(node, 1)|trans }}" data-unit-other="{{ component.unitFor(node, 2)|trans }}"{% endif -%}
{% endmacro %}

{% macro ingredientButton(component, node, class) %}
    {%- set count = node.max ?? node.min ?? 0 -%}
    <button type="button"
            data-node-id="{{ node.id }}"
            data-action="click->recipe-progress#toggle"
            aria-pressed="false"
            class="{{ class }}"
    >
        {%- if node.min is not null %}
            <strong data-quantity class="font-mono">
                {%- if node.max is not null -%}
                    {{ 'quantity.range'|trans({min: component.formatQuantity(node.min), max: component.formatQuantity(node.max)}) }}
                {%- else -%}
                    {{ component.formatQuantity(node.min) }}
                {%- endif -%}
                {%- if node.unit %} {{ component.unitFor(node, count)|trans }}{% endif -%}
            </strong>
        {% endif %}
        {{ node.label }}
    </button>
{% endmacro %}

{% macro stepButton(node, class, testid = null) %}
    <button type="button"
            data-node-id="{{ node.id }}"
            {%- if testid %} data-testid="{{ testid }}"{% endif %}
            data-action="click->recipe-progress#toggle"
            aria-pressed="false"
            class="{{ class }}"
    >{{ node.text }}</button>
{% endmacro %}

{% set grid = this.grid %}

<div class="hidden overflow-x-auto md:block">
    <table class="w-full border-collapse text-sm">
        <caption data-testid="recipe-grid-caption" class="sr-only">{{ 'recipes.grid_caption'|trans({name: recipe.name ?? ''}) }}</caption>
        <tbody>
            {% for row in grid.rows %}
                <tr>
                    {% for cell in row.cells %}
                        {% if cell.isGap %}
                            <td data-testid="recipe-grid-gap" colspan="{{ cell.colSpan }}" rowspan="{{ cell.rowSpan }}" class="border border-transparent"></td>
                        {% elseif cell.isIngredient %}
                            {# h-px laisse la cellule grandir mais donne une hauteur au bouton, qui remplit alors
                               toute la cellule fusionnée: la zone cliquable et le survol couvrent le bloc entier. #}
                            <td rowspan="{{ cell.rowSpan }}"
                                class="h-px border border-slate-200 dark:border-white/10"
                                {{- m.ingredientData(this, cell.node) }}
                            >
                                {{ m.ingredientButton(this, cell.node, 'flex h-full w-full cursor-pointer flex-wrap items-center gap-x-1 px-3 py-2 text-left transition-colors hover:bg-slate-100 dark:hover:bg-white/5') }}
                            </td>
                        {% else %}
                            {# La barre à gauche pointe le sens de lecture: les ingrédients de la ligne alimentent cette étape. #}
                            <td rowspan="{{ cell.rowSpan }}"
                                class="h-px border border-l-4 border-primary-500/30 border-l-primary-500 bg-primary-500/10 transition-colors has-[.is-done]:border-slate-200 has-[.is-done]:border-l-slate-300 has-[.is-done]:bg-transparent dark:border-primary-400/30 dark:border-l-primary-400 dark:bg-primary-400/10 dark:has-[.is-done]:border-white/10 dark:has-[.is-done]:border-l-white/20"
                            >
                                {{ m.stepButton(cell.node, 'flex h-full w-full cursor-pointer items-center justify-center px-3 py-2 text-center font-semibold transition-colors hover:bg-primary-500/15 dark:hover:bg-primary-400/15') }}
                            </td>
                        {% endif %}
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="md:hidden">
    <h2 class="mb-2 text-lg font-semibold">{{ 'recipes.ingredients'|trans }}</h2>
    <ul class="space-y-1">
        {% for ingredient in this.flatIngredients %}
            <li class="border-b border-slate-200 dark:border-white/10"
                {{- m.ingredientData(this, ingredient) }}
            >
                {{ m.ingredientButton(this, ingredient, 'block w-full py-2 text-left') }}
            </li>
        {% endfor %}
    </ul>

    <h2 class="mt-6 mb-2 text-lg font-semibold">{{ 'recipes.steps'|trans }}</h2>
    <ol class="space-y-3">
        {% for step in this.flatSteps %}
            <li data-testid="recipe-step"
                class="border-l-4 border-primary-500 bg-primary-500/10 transition-colors has-[.is-done]:border-l-slate-300 has-[.is-done]:bg-transparent dark:border-primary-400 dark:has-[.is-done]:border-l-white/20 dark:bg-primary-400/10">
                <div class="flex items-baseline gap-2 px-3 pt-2">
                    <span class="font-semibold text-zinc-500 dark:text-zinc-400">{{ loop.index }}.</span>
                    {{ m.stepButton(step, 'flex-1 cursor-pointer text-left font-semibold', 'recipe-step-text') }}
                </div>

                {# Sans ses entrées, une étape comme « faire revenir 15min » ne dit pas quoi faire revenir:
                   la grille porte le lien sur grand écran, cette liste le porte ici. #}
                <ul class="space-y-1 px-3 pb-2 text-sm">
                    {% for number in this.requiredStepNumbers(step) %}
                        <li class="text-zinc-500 dark:text-zinc-400"><span aria-hidden="true" class="mr-1">&rarr;</span>{{ 'recipes.step_result'|trans({number}) }}</li>
                    {% endfor %}
                    {% for ingredient in this.directIngredients(step) %}
                        <li class="flex" {{- m.ingredientData(this, ingredient) }}>
                            <span aria-hidden="true" class="mr-1 text-zinc-500 dark:text-zinc-400">&rarr;</span>
                            {{ m.ingredientButton(this, ingredient, 'flex-1 cursor-pointer text-left') }}
                        </li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ol>
</div>
