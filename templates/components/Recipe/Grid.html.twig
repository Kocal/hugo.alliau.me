{% import _self as m %}

{% macro ingredientData(component, node) %}
    {%- if node.min is not null %} data-qty-min="{{ node.min }}"{% endif -%}
    {%- if node.max is not null %} data-qty-max="{{ node.max }}"{% endif -%}
    {%- if node.unit %} data-unit-one="{{ component.unitFor(node, 1)|trans }}" data-unit-other="{{ component.unitFor(node, 2)|trans }}"{% endif -%}
{% endmacro %}

{% macro ingredientButton(component, node, class) %}
    {%- set count = node.max ?? node.min ?? 0 -%}
    <button type="button"
            data-node-id="{{ node.id }}"
            data-action="click->recipe-progress#toggle"
            aria-pressed="false"
            class="{{ class }}"
    >
        {%- if node.min is not null %}
            <strong data-quantity class="{{ css({
                fontVariantNumeric: 'tabular-nums',
            }) }}">
                {%- if node.max is not null -%}
                    {{ 'quantity.range'|trans({min: component.formatQuantity(node.min), max: component.formatQuantity(node.max)}) }}
                {%- else -%}
                    {{ component.formatQuantity(node.min) }}
                {%- endif -%}
                {%- if node.unit %} {{ component.unitFor(node, count)|trans }}{% endif -%}
            </strong>
        {% endif %}
        {{ node.label }}
    </button>
{% endmacro %}

{% macro stepButton(node, class, testid = null) %}
    <button type="button"
            data-node-id="{{ node.id }}"
            {%- if testid %} data-testid="{{ testid }}"{% endif %}
            data-action="click->recipe-progress#toggle"
            aria-pressed="false"
            class="{{ class }}"
    >{{ node.text }}</button>
{% endmacro %}

{% set grid = this.grid %}

<div class="{{ css({
    display: {base: 'none', md: 'block'},
    overflowX: 'auto',
}) }}">
    <table class="{{ css({
        w: 'full',
        fontSize: 'sm',
        lineHeight: 'sm',
    }) }}">
        <caption data-testid="recipe-grid-caption" class="{{ css({
            srOnly: true,
        }) }}">{{ 'recipes.grid_caption'|trans({name: recipe.name ?? ''}) }}</caption>
        <tbody>
            {% for row in grid.rows %}
                <tr>
                    {% for cell in row.cells %}
                        {% if cell.isGap %}
                            <td data-testid="recipe-grid-gap" colspan="{{ cell.colSpan }}" rowspan="{{ cell.rowSpan }}" class="{{ css({
                                borderWidth: 1,
                                borderColor: 'transparent',
                            }) }}"></td>
                        {% elseif cell.isIngredient %}
                            {# Une hauteur de 1px laisse la cellule grandir mais donne une hauteur au bouton, qui remplit alors
                               toute la cellule fusionnée: la zone cliquable et le survol couvrent le bloc entier. #}
                            <td rowspan="{{ cell.rowSpan }}"
                                class="{{ css({
                                    h: '[1px]',
                                    borderWidth: 1,
                                    borderColor: 'border',
                                }) }}"
                                {{- m.ingredientData(this, cell.node) }}
                            >
                                {{ m.ingredientButton(this, cell.node, css({
                                    display: 'flex',
                                    h: 'full',
                                    w: 'full',
                                    minW: '40',
                                    cursor: 'pointer',
                                    flexWrap: 'wrap',
                                    alignItems: 'center',
                                    columnGap: '1',
                                    px: '3',
                                    py: '2',
                                    textAlign: 'left',
                                    transition: 'colors',
                                    bgColor: {_hover: 'bg.hover'},
                                })) }}
                            </td>
                        {% else %}
                            {# La barre à gauche pointe le sens de lecture: les ingrédients de la ligne alimentent cette étape. #}
                            <td rowspan="{{ cell.rowSpan }}"
                                class="{{ css({
                                    h: '[1px]',
                                    borderWidth: 1,
                                    borderLeftWidth: 4,
                                    borderColor: 'accent/30',
                                    borderLeftColor: 'accent',
                                    bgColor: 'accent/10',
                                    transition: 'colors',
                                    '&:has(.is-done)': {
                                        borderColor: 'border',
                                        borderLeftColor: 'border.strong',
                                        bgColor: 'transparent',
                                    },
                                }) }}"
                            >
                                {{ m.stepButton(cell.node, css({
                                    display: 'flex',
                                    h: 'full',
                                    w: 'full',
                                    cursor: 'pointer',
                                    alignItems: 'center',
                                    justifyContent: 'center',
                                    px: '3',
                                    py: '2',
                                    textAlign: 'center',
                                    fontWeight: 'semibold',
                                    transition: 'colors',
                                    bgColor: {_hover: 'accent/15'},
                                })) }}
                            </td>
                        {% endif %}
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="{{ css({
    display: {md: 'none'},
}) }}">
    <h2 class="{{ css({
        mb: '2',
        fontSize: 'lg',
        lineHeight: 'lg',
        fontWeight: 'semibold',
    }) }}">{{ 'recipes.ingredients'|trans }}</h2>
    <ul class="{{ css({
        spaceY: '1',
    }) }}">
        {% for ingredient in this.flatIngredients %}
            <li class="{{ css({
                    borderBottomWidth: 1,
                    borderColor: 'border',
                }) }}"
                {{- m.ingredientData(this, ingredient) }}
            >
                {{ m.ingredientButton(this, ingredient, css({
                    display: 'block',
                    w: 'full',
                    py: '2',
                    textAlign: 'left',
                })) }}
            </li>
        {% endfor %}
    </ul>

    <h2 class="{{ css({
        mt: '6',
        mb: '2',
        fontSize: 'lg',
        lineHeight: 'lg',
        fontWeight: 'semibold',
    }) }}">{{ 'recipes.steps'|trans }}</h2>
    <ol class="{{ css({
        spaceY: '3',
    }) }}">
        {% for step in this.recipe.content.stepsInExecutionOrder() %}
            <li data-testid="recipe-step"
                class="{{ css({
                    borderLeftWidth: 4,
                    borderColor: 'accent',
                    bgColor: 'accent/10',
                    transition: 'colors',
                    '&:has(.is-done)': {
                        borderLeftColor: 'border.strong',
                        bgColor: 'transparent',
                    },
                }) }}">
                <div class="{{ css({
                    display: 'flex',
                    alignItems: 'baseline',
                    gap: '2',
                    px: '3',
                    pt: '2',
                }) }}">
                    <span class="{{ css({
                        fontWeight: 'semibold',
                        color: 'fg.muted',
                    }) }}">{{ loop.index }}.</span>
                    {{ m.stepButton(step, css({
                        flex: '1',
                        cursor: 'pointer',
                        textAlign: 'left',
                        fontWeight: 'semibold',
                    }), 'recipe-step-text') }}
                </div>

                {# Sans ses entrées, une étape comme « faire revenir 15min » ne dit pas quoi faire revenir:
                   la grille porte le lien sur grand écran, cette liste le porte ici. #}
                <ul class="{{ css({
                    spaceY: '1',
                    px: '3',
                    pb: '2',
                    fontSize: 'sm',
                    lineHeight: 'sm',
                }) }}">
                    {% for number in this.requiredStepNumbers(step) %}
                        <li class="{{ css({
                            color: 'fg.muted',
                        }) }}"><span aria-hidden="true" class="{{ css({
                            mr: '1',
                        }) }}">&rarr;</span>{{ 'recipes.step_result'|trans({number}) }}</li>
                    {% endfor %}
                    {% for ingredient in step.ingredients() %}
                        <li class="{{ css({
                            display: 'flex',
                        }) }}" {{- m.ingredientData(this, ingredient) }}>
                            <span aria-hidden="true" class="{{ css({
                                mr: '1',
                                color: 'fg.muted',
                            }) }}">&rarr;</span>
                            {{ m.ingredientButton(this, ingredient, css({
                                flex: '1',
                                cursor: 'pointer',
                                textAlign: 'left',
                            })) }}
                        </li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ol>
</div>
