{% set style = html_cva(
    css({
        mb: '4',
        py: '3',
        px: '4',
        rounded: 'sm',
        borderWidth: 1,
        borderLeftWidth: 5,
        borderColor: 'border.prose',
        bgColor: 'bg.surface',
    }),
    {
        type: {
            info: css({
                borderLeftColor: 'blue.600',
                '& [data-header]': {
                    color: 'callout.info',
                },
            }),
            tip: css({
                borderLeftColor: 'green.600',
                '& [data-header]': {
                    color: 'callout.tip',
                },
            }),
            warning: css({
                borderLeftColor: 'yellow.600',
                '& [data-header]': {
                    color: 'callout.warning',
                },
            }),
            danger: css({
                borderLeftColor: 'red.600',
                '& [data-header]': {
                    color: 'callout.danger',
                },
            }),
        },
    }
) %}
<div class="{{ style.apply({type}) }}">
    <div class="{{ css({
        display: 'flex',
        gap: '2',
        alignItems: 'center',
        mb: '2',
    }) }}" data-header>
        {% if type === 'info' %}
            <twig:ux:icon name="lucide:info" />
        {% elseif type === 'tip' %}
            <twig:ux:icon name="lucide:lightbulb" />
        {% elseif type === 'warning' %}
            <twig:ux:icon name="lucide:triangle-alert" />
        {% elseif type === 'danger' %}
            <twig:ux:icon name="lucide:octagon-alert" />
        {% endif %}
        <span class="{{ css({
            fontFamily: 'sans',
            fontSize: 'sm',
            lineHeight: 'sm',
            fontWeight: 'bold',
            userSelect: 'none',
        }) }}">{{ type|capitalize }}</span>
    </div>
    <div class="prose {{ css({
        '& > p:not(:first-child)': {
            mt: '0',
        },
        '& > p:not(:last-child)': {
            mb: '2',
        },
    }) }}">{{ content|raw }}</div>
</div>
