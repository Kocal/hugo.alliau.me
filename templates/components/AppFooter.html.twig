<footer {{ attributes.defaults({
    role: 'contentinfo',
    class: css({
        shadow: 'inset-sm',
        bgColor: 'bg.footer',
        display: {_print: 'none'},
    }),
}) }}>
    <div class="{{ css({
        w: 'full',
        mx: 'auto',
        py: {base: '6', sm: '12'},
        maxW: 'breakpoint-lg',
        display: 'flex',
        gap: '4',
        flexDirection: {base: 'column', sm: 'row'},
    }) }}">
        <div>
            <div class="{{ css({
                display: 'flex',
                justifyContent: 'center',
                columnGap: '4',
                px: '2',
            }) }}">
                <img
                    src="{{ asset('build/images/hugo-alliaume.jpeg') }}"
                    width="92"
                    height="92"
                    decoding="async"
                    loading="lazy"
                    alt="Hugo Alliaume"
                    class="{{ css({
                        gridRow: 'span 2 / span 2',
                        rounded: 'full',
                        shadow: 'lg',
                        alignSelf: 'flex-start',
                    }) }}"
                />

                <div>
                    <span class="{{ css({
                        alignSelf: 'center',
                        fontSize: {base: '2xl', sm: '3xl', _print: 'xl'},
                        lineHeight: {base: '2xl', sm: '3xl', _print: 'xl'},
                        fontWeight: 'extrabold',
                        letterSpacing: 'tight',
                    }) }}">Hugo Alliaume</span>
                    <p class="{{ css({
                        mt: '2',
                        fontSize: 'sm',
                        lineHeight: 'sm',
                    }) }}">{{ 'footer.role.dev'|trans }},<br>{{ 'footer.role.oss'|trans }},<br>{{ 'footer.role.team'|trans }}</p>

                    <ul class="{{ css({
                        mt: '3',
                        display: 'flex',
                        gap: '2',
                        fontSize: 'sm',
                        lineHeight: 'sm',
                    }) }}">
                        {% for network in [
                            {title: 'Email', href: 'mailto:hugo@alliau.me', icon: 'bi:envelope', text: 'hugo[at]alliau.me', class: css({
                                color: {_hover: 'fg.hover'},
                            })},
                            {title: 'LinkedIn', href: 'https://www.linkedin.com/in/%F0%9F%9A%B4-hugo-alliaume-34b475166/', icon: 'bi:linkedin', text: 'Hugo Alliaume', class: css({
                                color: {_hover: 'brand.linkedin'},
                            })},
                            {title: 'GitHub', href: 'https://github.com/Kocal', icon: 'bi:github', text: '@Kocal', class: css({
                                color: {_hover: 'brand.github'},
                            })},
                            {title: 'X (Twitter)', href: 'https://twitter.com/HugoAlliaume', icon: 'bi:twitter', text: '@HugoAlliaume', class: css({
                                color: {_hover: 'brand.twitter'},
                            })},
                            {title: 'Bluesky', href: 'https://bluesky.dev/hugo.alliau.me', icon: 'simple-icons:bluesky', text: 'hugo.alliau.me', class: css({
                                color: {_hover: 'brand.bsky'},
                            })},
                            {title: 'Mastodon', href: 'https://mastodon.social/@Kocal', icon: 'bi:mastodon', text: '@Kocal', class: css({
                                color: {_hover: 'brand.mastodon'},
                            })},
                        ] %}
                            <li>
                                <a href="{{ network.href }}" title="{{ network.title }}" class="{{ css({
                                    display: {_print: 'flex'},
                                    alignItems: 'center',
                                    gap: '2',
                                    transition: 'colors',
                                }) }} {{ network.class }}" rel="me" itemprop="sameAs">
                                    <twig:UX:Icon :name="network.icon" width="1.6em" height="1.6em" />
                                    <span class="{{ css({
                                        display: {base: 'none', _print: 'block'},
                                    }) }}">{{ network.text }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        <div class="{{ css({
            flex: '1',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            px: '2',
        }) }}">
            <blockquote class="{{ css({
                display: {_empty: 'none'},
                maxW: 'sm',
                textAlign: 'center',
                fontStyle: 'italic',
                fontSize: '2xl',
                lineHeight: '2xl',
                fontFamily: 'serif',
                _before: {
                    content: '"“"',
                },
                _after: {
                    content: '"”"',
                },
            }) }}"></blockquote>
            <script>
                const quotes = [
                    "Don't forget about DX!",
                    "Eat 5 fruits and vegetables a day.",
                    "When you read this, I may be enjoying a nice meal.",
                    "Faites-mieux !",
                    "Glory to DDD and CQRS!",
                    "Do not fear contributing to open source, even the smallest contributions count!",
                    "I'm probably working on Symfony UX right now.",
                    "Rest in peace, Ryan ❤️",
                    "Free Palestine! 🇵🇸",
                    "Free Ukraine! 🇺🇦",
                    "Not using PHPStan, PHP-CS-Fixer, or Rector? What are you waiting for?",
                    "Symfony! Symfony! Symfony!",
                    "Keep your dependencies up to date!",
                ];

                document.currentScript.previousElementSibling.textContent = quotes[Math.floor(Math.random() * quotes.length)];
            </script>
        </div>
    </div>
    <div class="{{ css({
        borderTopWidth: 1,
        borderColor: 'border',
    }) }}">
        <div class="{{ css({
            w: 'full',
            maxW: 'breakpoint-lg',
            mx: 'auto',
            p: '2',
            fontSize: 'xs',
            lineHeight: 'xs',
            textAlign: 'center',
        }) }}">
            {{ 'now'|date('Y') }}
            &bullet; {{ 'footer.revision'|trans }} <a href="https://github.com/Kocal/hugo.alliau.me/commit/{{ SOURCE_COMMIT }}" class="{{ css({
                fontFamily: 'mono',
            }) }}">{{ SOURCE_COMMIT|slice(0, 8) }}</a>
        </div>
    </div>
</footer>
