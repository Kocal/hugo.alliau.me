{% props as = 'span' %}
<{{ as }}{{ attributes.defaults({
    class: css({
        fontSize: {base: 'lg', sm: '2xl'},
        lineHeight: {base: 'lg', sm: '2xl'},
        fontWeight: 'bold',
        my: {base: '2', sm: '3'},
        letterSpacing: '-0.025em',
        whiteSpace: 'nowrap',
    }),
}) }}>
    {% block content %}{% endblock %}
</{{ as }}>
