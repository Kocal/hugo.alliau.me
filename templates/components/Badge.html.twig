{% props href = false, color = 'primary', size = 'regular' %}

{% set style_badge = html_cva(
    base: css({
        display: 'inline-flex',
        alignItems: 'center',
        rounded: 'md',
        borderWidth: '[1px]',
        fontWeight: 'medium',
        transition: 'colors',
    }),
    variants: {
        color: {
            primary: css({
                color: 'accent.fg',
                bgColor: 'accent/10',
                borderColor: 'accent/20',
            }),
            gray: css({
                color: 'fg.secondary',
                bgColor: 'fg.muted/10',
                borderColor: 'fg.muted/20',
            }),
        },
        size: {
            regular: css({
                px: '2',
                py: '0.5',
                fontSize: 'sm',
                lineHeight: 'sm',
            }),
            sm: css({
                px: '1.5',
                py: '0.5',
                fontSize: 'xs',
                lineHeight: 'xs',
            }),
        },
        hoverable: {
            'true': css({
                bgColor: {_hover: 'accent/20'},
            }),
            'false': '',
        },
    },
) %}

<{{ href ? 'a' : 'span' }} class="{{ style_badge.apply({color, size, hoverable: href ? 'true' : 'false'}, attributes.render('class') ?? '') }}" {{
    attributes.defaults({href}) }}>
    {{- block('content') -}}
</{{ href ? 'a' : 'span' }}>
