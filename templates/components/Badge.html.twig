{% props href = false, color = 'primary', size = 'regular' %}

{% set style_badge = cva(
    base: {
        display: 'inline-flex',
        alignItems: 'center',
        rounded: 'md',
        borderWidth: 1,
        fontWeight: 'medium',
        transition: 'colors',
    },
    variants: {
        color: {
            primary: {
                color: 'accent.fg',
                bgColor: 'accent/10',
                borderColor: 'accent/20',
            },
            gray: {
                color: 'fg.secondary',
                bgColor: 'fg.muted/10',
                borderColor: 'fg.muted/20',
            },
        },
        size: {
            regular: {
                px: '2',
                py: '0.5',
                fontSize: 'sm',
                lineHeight: 'sm',
            },
            sm: {
                px: '1.5',
                py: '0.5',
                fontSize: 'xs',
                lineHeight: 'xs',
            },
        },
        hoverable: {
            'true': {
                bgColor: {_hover: 'accent/20'},
            },
            'false': {},
        },
    },
) %}

<{{ href ? 'a' : 'span' }} {{ attributes.defaults({
    class: style_badge.apply({color, size, hoverable: href ? 'true' : 'false'}),
    href,
}) }}>
    {{- block('content') -}}
</{{ href ? 'a' : 'span' }}>
