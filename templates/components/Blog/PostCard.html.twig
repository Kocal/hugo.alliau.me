{% props post %}
<twig:Card as="article" class="{{ css({
    p: {base: '4', sm: '6'},
}) }}">
    <header>
        <h2 class="{{ css({
            fontSize: {base: '2xl', sm: '3xl'},
            lineHeight: {base: '2xl', sm: '3xl'},
            fontWeight: 'bold',
            mb: '3',
            letterSpacing: '-0.025em',
            color: {_hover: 'fg.hover'},
            transition: 'colors',
        }) }}">
            <a href="{{ path(constant('App\\Blog\\Domain\\Data\\Route::POST_VIEW').value, {slug: post.slug}) }}">
                {{ post.title }}
            </a>
        </h2>
    </header>

    <p>{{ post.description }}</p>

    <footer class="{{ css({
        mt: '4',
    }) }}">
        <twig:Blog:PostMeta :post="post" />
    </footer>
</twig:Card>
