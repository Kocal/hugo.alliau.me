<header class="{{ css({
    display: {_print: 'none'},
    position: 'sticky',
    top: '0',
    zIndex: 40,
    borderBottomWidth: '[1px]',
    borderColor: 'border.subtle',
    bgColor: 'bg.canvas/70',
    backdropFilter: '[blur(12px)]',
}) }}">
    <twig:Navbar>
        <twig:Navbar:LogoText as="a" href="{{ path(constant('App\\Shared\\Domain\\Data\\Route::HOME').value) }}">
