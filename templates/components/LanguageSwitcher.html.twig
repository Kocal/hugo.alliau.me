{% set fallback_route = app.current_route ? single_locale_fallback_route(app.current_route) : null %}
{% set target_route = fallback_route ?? app.current_route %}
{% set target_parameters = fallback_route ? {} : app.current_route_parameters %}

<ul class="flex items-center gap-1.5 text-2xl" aria-label="{{ 'nav.language'|trans }}">
    {% for locale in enabled_locales() %}
        {% set is_current = locale.value == app.request.locale %}
        <li>
            <a
                href="{{ path(target_route, target_parameters|merge({_locale: locale.value})) }}"
                hreflang="{{ locale.value }}"
                title="{{ locale.toTranslatable|trans }}"
                class="block leading-none transition-opacity {{ is_current ? '' : 'opacity-50 hover:opacity-100' }}"
                {% if is_current %}aria-current="true"{% endif %}
            >
                {{ locale.flag }}
            </a>
        </li>
    {% endfor %}
</ul>
