<p class="{{ css({
    fontWeight: 'bold',
    fontSize: 'xl',
    lineHeight: 'xl',
}) }}">{{ place.address.name }}</p>
<p class="{{ css({
    fontSize: 'md',
    lineHeight: 'md',
    fontWeight: 'normal',
}) }}">{{ place.address.formattedAddress }}</p>
<ul class="{{ css({
    display: 'flex',
    flexWrap: 'wrap',
    gap: '1',
}) }}">
    {% for type in place.types %}
        <li class="{{ css({
            color: 'primary.50',
            bgColor: 'primary.700',
            textTransform: 'uppercase',
            fontSize: 'xs',
            lineHeight: 'xs',
            fontWeight: 'bold',
            px: '1',
            py: '0.5',
            rounded: 'sm',
        }) }}">{{ type.toTranslatable|trans }}</li>
    {% endfor %}
</ul>
<p class="{{ css({
    fontSize: 'md',
    lineHeight: 'md',
    mt: '2',
}) }}">
    <a href="{{ place.googleMapsUrl }}" rel="noreferrer noopener" target="_blank" class="{{ css({
        textDecorationLine: 'underline',
        fontWeight: 'normal',
        color: 'primary.600',
    }) }}">
        Google Maps
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="{{ css({
            display: 'inline-block',
            w: '5',
            h: '5',
        }) }}">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
    </a>
</p>
