{% extends 'base.html.twig' %}
{% set show_footer = false %}

{% block title %}{{ 'places.title'|trans }} | Hugo Alliaume{% endblock %}

{% block seo %}
    <meta name="description" content="{{ 'places.meta_description'|trans }}">
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block main %}
<main class="{{ css({
    flex: '1',
    position: 'relative',
}) }}"
      data-controller="places"
      data-places-countries-value="{{ countries|json_encode|e('html_attr') }}"
      data-places-cluster-class="{{ css({
          display: 'flex',
          boxSize: 'full',
          alignItems: 'center',
          justifyContent: 'center',
          rounded: 'full',
          borderWidth: '2px',
          borderColor: 'white',
          bgColor: '[#126FC6]',
          fontSize: 'sm',
          lineHeight: 'sm',
          fontWeight: 'semibold',
          color: 'white',
          shadow: 'md',
      }) }}">
    <div class="{{ css({
        position: 'absolute',
        top: '4',
        left: '4',
        zIndex: 1000,
        bgColor: 'bg.surface',
        rounded: 'sm',
        shadow: 'md',
        p: '2',
    }) }}">
        <label for="places-country" class="{{ css({
            srOnly: true,
        }) }}">{{ 'places.filter.country'|trans }}</label>
        <select id="places-country"
                data-places-target="country"
                data-action="change->places#onCountryChange"
                class="{{ css({
                    bgColor: 'transparent',
                    color: 'fg',
                    fontSize: 'sm',
                    lineHeight: 'sm',
                    outlineStyle: {_focus: 'none'},
                    cursor: 'pointer',
                }) }}">
            <option value="">{{ 'places.filter.all_countries'|trans }}</option>
            {% for name, data in countries %}
                <option value="{{ name }}">{{ name }} ({{ data.placesCount }})</option>
            {% endfor %}
        </select>
    </div>
    {{ ux_map(map, {
        'data-places-target': 'map',
        class: css({
            position: 'absolute',
            top: '0',
            bottom: '0',
            right: '0',
            left: '0',
        }),
    }) }}
</main>
{% endblock %}
